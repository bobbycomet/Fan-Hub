/* Fan Hub — Dark Cyberpunk Theme (v1.4) */
/* KEY FIX: QGroupBox titles use subcontrol-origin:margin so the title renders
   inside the margin area. We need margin-top large enough to fit the title,
   and padding-top large enough that content clears the title.
   Formula: margin-top >= font_size + 8px; padding-top >= margin-top - 4px */

/* ── Global ──────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #0a0a14;
    color: #c8d0e0;
    font-family: "JetBrains Mono", "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 12px;
}

QMainWindow {
    background-color: #07070f;
}

/* ── Top bar ─────────────────────────────────────────────────────────────── */
QFrame#topbar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0d0d1f, stop:0.5 #0a1030, stop:1 #0d0d1f);
    border-bottom: 1px solid #1a2050;
}

QLabel#appTitle {
    color: #00ddff;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 3px;
}

QPushButton#emergencyBtn {
    background-color: #220000;
    color: #ff4444;
    border: 1px solid #ff2222;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: bold;
}
QPushButton#emergencyBtn:hover {
    background-color: #440000;
    border-color: #ff6666;
}

QPushButton#autoBtn, QPushButton#scanBtn {
    background-color: #0a1530;
    color: #88aaff;
    border: 1px solid #223388;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton#autoBtn:hover, QPushButton#scanBtn:hover {
    background-color: #112040;
    border-color: #4466cc;
}

QLabel#statusDot {
    font-size: 12px;
    padding: 4px 8px;
}

/* ── Tabs ────────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #08080f;
}

QTabBar::tab {
    background-color: #0d0d1a;
    color: #667788;
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #00ddff;
    border-bottom: 2px solid #00ddff;
    background-color: #0a1025;
}

QTabBar::tab:hover:!selected {
    color: #99bbdd;
    background-color: #0c0c20;
}

/* ── Group boxes — FIXED title rendering ─────────────────────────────────
   margin-top: space above the box (title renders here via subcontrol-origin:margin)
   padding-top: clearance inside the box so content doesn't overlap the title
   title top: negative offset within the margin area — keep it modest
   ──────────────────────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #1a2040;
    border-radius: 6px;
    /* margin-top must be >= title height. At 12px font, title is ~20px tall.
       Add a few px buffer so the border doesn't cut through the text. */
    margin-top: 22px;
    /* padding-top pushes content below the title zone */
    padding-top: 14px;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    font-size: 12px;
    font-weight: bold;
    color: #8899bb;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    /* Position the title inside the margin area, vertically centred */
    top: 4px;
    left: 12px;
    /* Horizontal padding so text has breathing room from the border */
    padding: 0px 6px;
    color: #aabbdd;
    background-color: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* Variant IDs — only override what differs from the base */
QGroupBox#dashGroup {
    border-color: #1a2855;
}

QGroupBox#controlGroup {
    border-color: #1a3040;
}

QGroupBox#settingsGroup {
    border-color: #1a2844;
    /* Settings groups need extra top clearance because section names can be longer */
    margin-top: 24px;
    padding-top: 16px;
}

QGroupBox#settingsGroup::title {
    color: #bbccee;
    font-size: 13px;
}

/* ── Settings tab labels — ensure descriptions are never clipped ──────────
   QLabel inside settingsGroup must have no maximum height constraint.
   min-height: 0 + no max-height = free to grow with wrapped text.       */
QGroupBox#settingsGroup QLabel {
    background: transparent;
    border: none;
    padding: 0px;
    /* No max-height — labels grow to fit wrapped text */
}

/* ── Fan channel widget ───────────────────────────────────────────────── */
QFrame#fanChannel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0d1020, stop:1 #090910);
    border: 1px solid #1a2244;
    border-radius: 8px;
    padding: 4px;
}

QFrame#fanChannel:hover {
    border-color: #2a3466;
}

QLabel#fanChannelName {
    color: #aabbdd;
    font-size: 13px;
}

QLabel#channelRPM {
    color: #44ff88;
    font-weight: bold;
    font-size: 14px;
}

QLabel#liveBar {
    color: #00aacc;
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 1px;
}

/* ── Dashboard gauges ────────────────────────────────────────────────── */
QFrame#tempGauge {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0d1428, stop:1 #080812);
    border: 1px solid #1a2244;
    border-radius: 8px;
}

QLabel#gaugeLabel {
    color: #8899aa;
    font-size: 11px;
}

QLabel#gaugeValue {
    color: #00ccff;
    font-size: 20px;
    font-weight: bold;
}

QFrame#fanCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0d1020, stop:1 #080810);
    border: 1px solid #1a2040;
    border-radius: 8px;
}

QLabel#fanCardLabel {
    color: #8899bb;
    font-size: 11px;
}

QLabel#fanRPM {
    color: #44ff88;
    font-size: 16px;
    font-weight: bold;
}

QLabel#fanPct {
    color: #00aaff;
    font-size: 12px;
}

QLabel#fanMode {
    color: #556677;
    font-size: 10px;
}

/* ── Charts ──────────────────────────────────────────────────────────── */
QChartView#chartView {
    background-color: #0a0a1a;
    border: 1px solid #1a2040;
    border-radius: 6px;
}

/* ── Liquid cards ────────────────────────────────────────────────────── */
QFrame#liquidCard {
    background: #0c1020;
    border: 1px solid #1a3050;
    border-radius: 6px;
    padding: 4px;
}

QFrame#liquidPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0c1420, stop:1 #08080f);
    border: 1px solid #1a3244;
    border-radius: 8px;
}

QLabel#liquidDeviceName {
    color: #44aaff;
    font-size: 14px;
}

/* ── RGB device cards ────────────────────────────────────────────────── */
QFrame#rgbDeviceCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0d0d20, stop:1 #080810);
    border: 1px solid #2a1a40;
    border-radius: 8px;
    padding: 4px;
}

QLabel#rgbDeviceName {
    color: #bb88ff;
    font-size: 13px;
}

/* ── RGB status bar ──────────────────────────────────────────────────── */
QFrame#rgbStatusBar {
    border-bottom: 1px solid #1a2040;
}

/* ── Buttons ─────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #111830;
    color: #8899cc;
    border: 1px solid #223366;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #162040;
    color: #aabbee;
    border-color: #334488;
}

QPushButton:pressed {
    background-color: #0d1428;
}

QPushButton:disabled {
    color: #334455;
    border-color: #112233;
}

QPushButton#applyBtn {
    background-color: #0a2040;
    color: #44aaff;
    border: 1px solid #1a4488;
    font-weight: bold;
}

QPushButton#applyBtn:hover {
    background-color: #0d2850;
    color: #66ccff;
    border-color: #2255aa;
}

QPushButton#smallBtn {
    padding: 3px 8px;
    font-size: 11px;
    min-height: 20px;
}

/* ── Sliders ─────────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #0d1428;
    height: 6px;
    border-radius: 3px;
    border: 1px solid #1a2840;
}

QSlider::handle:horizontal {
    background: #00aaff;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 2px solid #0066cc;
}

QSlider::handle:horizontal:hover {
    background: #33ccff;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #003366, stop:1 #0066cc);
    border-radius: 3px;
}

/* ── Spinboxes ───────────────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #0d1020;
    color: #aabbdd;
    border: 1px solid #1a2840;
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 26px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0066cc;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #111828;
    border: none;
    width: 18px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* ── Combo boxes ─────────────────────────────────────────────────────── */
QComboBox {
    background-color: #0d1020;
    color: #aabbdd;
    border: 1px solid #1a2840;
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 80px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #2a4060;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #0d1428;
    color: #aabbdd;
    border: 1px solid #1a2840;
    selection-background-color: #1a3060;
}

/* ── Line edits ──────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #0d1020;
    color: #aabbdd;
    border: 1px solid #1a2840;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 26px;
}

QLineEdit:focus {
    border-color: #0066cc;
}

/* ── List widgets ────────────────────────────────────────────────────── */
QListWidget {
    background-color: #0a0a14;
    border: 1px solid #1a2040;
    border-radius: 4px;
    color: #aabbdd;
}

QListWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #111122;
}

QListWidget::item:selected {
    background-color: #1a3060;
    color: #44aaff;
}

QListWidget::item:hover:!selected {
    background-color: #0d1830;
}

/* ── Tables ──────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: #0a0a14;
    border: 1px solid #1a2040;
    border-radius: 4px;
    gridline-color: #111128;
    color: #aabbdd;
}

QTableWidget::item:selected {
    background-color: #1a3060;
    color: #44aaff;
}

QHeaderView::section {
    background-color: #0d1428;
    color: #8899bb;
    border: none;
    border-bottom: 1px solid #1a2840;
    padding: 5px 8px;
    font-weight: bold;
}

/* ── Scroll areas ────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #08080f;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #1a2844;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #2a3860;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #08080f;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #1a2844;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Text edit ───────────────────────────────────────────────────────── */
QTextEdit {
    background-color: #0a0a14;
    color: #aabbdd;
    border: 1px solid #1a2040;
    border-radius: 4px;
    padding: 4px;
}

QTextEdit#profileDetail {
    font-size: 12px;
}

/* ── Checkboxes ──────────────────────────────────────────────────────── */
QCheckBox {
    color: #aabbdd;
    spacing: 6px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2a4060;
    border-radius: 3px;
    background: #0d1020;
}

QCheckBox::indicator:checked {
    background: #0066cc;
    border-color: #0088ff;
}

QCheckBox::indicator:hover {
    border-color: #4488cc;
}

/* ── Status bar ──────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #070710;
    color: #667788;
    border-top: 1px solid #1a2040;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ── Labels ──────────────────────────────────────────────────────────── */
QLabel#hintLabel {
    color: #445566;
    font-size: 11px;
    padding: 4px;
    font-style: italic;
}

QLabel#tempDisplay {
    color: #ff8844;
    font-weight: bold;
}

/* ── Tool tips ───────────────────────────────────────────────────────── */
QToolTip {
    background-color: #0d1428;
    color: #aabbdd;
    border: 1px solid #2a4060;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── Dialogs ─────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #0d1020;
}

QDialog {
    background-color: #0d1020;
}

/* ── Progress bars ───────────────────────────────────────────────────── */
QProgressBar {
    background-color: #0d1020;
    border: none;
    border-radius: 4px;
    text-align: center;
    min-height: 6px;
}

QProgressBar::chunk {
    background-color: #0066cc;
    border-radius: 4px;
}

/* ── Warning dialog ──────────────────────────────────────────────────── */
QFrame#warningHeader {
    background: #1a0a00;
    border: 1px solid #ff6600;
    border-radius: 8px;
    padding: 8px;
}
